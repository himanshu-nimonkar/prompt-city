{
  "name": "model-advisor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "start": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute model-advisor-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute model-advisor-db --remote --file=./schema.sql",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.131.0"
  }
}
